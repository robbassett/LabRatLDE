# Copy to .env and adjust. Every value shown is the built-in default, except LDE_ENV.

# Required, with no default: dev | prod. dev trusts request headers for identity; prod refuses them.
LDE_ENV=dev
LDE_HTTP_ADDR=:8080
LDE_DATABASE_URL=postgres://lde:lde@localhost:5432/lde?sslmode=disable
LDE_AUTO_MIGRATE=true
LDE_LOG_LEVEL=info
LDE_SHUTDOWN_TIMEOUT=15s
# Max bytes per streamed instrument upload (512 MiB)
LDE_MAX_INGEST_BYTES=536870912

# OIDC (SPEC-006, docs/identity.md). Issuer and audience are required when LDE_ENV=prod.
LDE_OIDC_ISSUER=
LDE_OIDC_AUDIENCE=
# Token claim holding the tenant uuid
LDE_OIDC_TENANT_CLAIM=lde_tenant
# The web UI's public (PKCE) client, and the scopes it asks for
LDE_OIDC_UI_CLIENT_ID=
LDE_OIDC_UI_SCOPES=openid profile email
# UI signs out after this long without activity (at least 1m)
LDE_UI_IDLE_TIMEOUT=15m
# A signature needs an ID token whose auth_time is at most this old (SPEC-008, docs/signatures.md).
# Prod only; it also needs LDE_OIDC_UI_CLIENT_ID.
LDE_SIGN_REAUTH_MAX_AGE=120s
